{
  "name": "servicecard",
  "version": "0.1.0",
  "private": true,
  "description": "Automotive NFC companion \u2014 tap a tag on a vehicle component, get its service card.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:ux": "cypress run --e2e",
    "test:ux:open": "cypress open --e2e",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration new",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "tags:mint": "tsx scripts/mint-tags.ts",
    "check:secrets": "tsx scripts/check-secret-boundaries.ts",
    "verify": "npm run typecheck && npm run lint && npm run check:secrets && npm run test:unit && npm run test:integration",
    "release": "pwsh -File scripts/local-release.ps1"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "idb": "8.0.3",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@serwist/next": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "cypress": "15.20.1",
    "cypress-real-events": "1.15.0",
    "eslint": "9.17.0",
    "eslint-config-next": "16.3.0",
    "happy-dom": "20.11.2",
    "pg": "^8.23.0",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "serwist": "9.5.12",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.1.0",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
